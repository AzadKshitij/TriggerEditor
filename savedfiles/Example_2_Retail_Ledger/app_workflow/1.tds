    {
      "id": 2607196374192,
      "title": "Formula",
      "pos_x": 1844.4780273437511,
      "pos_y": 175.90600585937506,
      "inputs": [
        {
          "id": 2607196385232,
          "index": 0,
          "multi_edges": false,
          "position": 2,
          "socket_type": 1
        }
      ],
      "outputs": [
        {
          "id": 2607119197008,
          "index": 0,
          "multi_edges": true,
          "position": 5,
          "socket_type": 3
        }
      ],
      "content": {
        "formula_sections": [
          {
            "target_column": "g",
            "formula_text": "[quantity] * [unit_price_local]",
            "editor_height": 60,
            "target_dtype": ""
          },
          {
            "target_column": "gross_local",
            "formula_text": "ROUND([g], 2)",
            "editor_height": 60,
            "target_dtype": ""
          },
          {
            "target_column": "discount_local",
            "formula_text": "ROUND([gross_local] * [discount_pct], 2)",
            "editor_height": 60,
            "target_dtype": ""
          },
          {
            "target_column": "net_local",
            "formula_text": "ROUND([gross_local] - [discount_local], 2)",
            "editor_height": 60,
            "target_dtype": ""
          },
          {
            "target_column": "total_local",
            "formula_text": "ROUND([net_local] + [tax_local] + [shipping_local], 2)",
            "editor_height": 60,
            "target_dtype": ""
          }
        ]
      },
      "label_text": "g",
      "label_visible": true,
      "label_offset": 10.0,
      "node_code": 3,
      "node_type": "preparation",
      "op": "preparation.formula"
    },
    {
