            "target_column": "unit_price_usd",
            "formula_text": "ROUND([unit_price_local] * [usd_rate], 2)",
            "editor_height": 60,
            "target_dtype": ""
          },
          {
            "target_column": "net_revenue_usd",
            "formula_text": "ROUND([net_local] * [usd_rate], 2)",
            "editor_height": 60,
            "target_dtype": ""
          },
          {
            "target_column": "tax_usd",
            "formula_text": "ROUND([tax_local] * [usd_rate], 2)",
            "editor_height": 60,
            "target_dtype": ""
          },
          {
            "target_column": "shipping_usd",
            "formula_text": "ROUND([shipping_local] * [usd_rate], 2)",
            "editor_height": 60,
            "target_dtype": ""
          },
          {
            "target_column": "total_usd",
            "formula_text": "ROUND([total_local] * [usd_rate], 2)",
            "editor_height": 60,
            "target_dtype": ""
          }
        ]
      },
