          },
          {
            "target_column": "gross_local",
            "formula_text": "[g]",
            "editor_height": 60,
            "target_dtype": ""
          },
          {
            "target_column": "discount_local",
            "formula_text": "[g] * [discount_pct]",
            "editor_height": 60,
            "target_dtype": ""
          },
          {
            "target_column": "net_local",
            "formula_text": "[g] - [discount_local]",
            "editor_height": 60,
            "target_dtype": ""
          },
          {
            "target_column": "total_local",
            "formula_text": "[net_local] + [tax_local] + [shipping_local]",
