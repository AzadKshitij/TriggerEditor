          "id": 2664157225648,
          "index": 0,
          "multi_edges": true,
          "position": 5,
          "socket_type": 3
        }
      ],
      "content": {
        "formula_sections": [
          {
            "target_column": "gross_revenue_usd",
            "formula_text": "ROUND([gross_revenue_usd], 2)",
            "editor_height": 60,
            "target_dtype": ""
          },
          {
            "target_column": "margin_pct",
            "formula_text": "CASE WHEN [net_revenue_usd] = 0 \nTHEN NULL \nELSE ROUND([gross_margin_usd] / [net_revenue_usd], 4) \nEND",
            "editor_height": 120,
            "target_dtype": ""
          }
        ]
      },
      "label_text": "",
      "label_visible": false,
      "label_offset": 10.0,
      "node_code": 3,
      "node_type": "preparation",
      "op": "preparation.formula"
    },
