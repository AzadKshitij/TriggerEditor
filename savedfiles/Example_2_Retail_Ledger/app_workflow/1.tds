    {
      "id": 2074988497808,
      "title": "Formula",
      "pos_x": 2166.2499999999995,
      "pos_y": 173.74999999999994,
      "inputs": [
        {
          "id": 2074988502768,
          "index": 0,
          "multi_edges": false,
          "position": 2,
          "socket_type": 1
        }
      ],
      "outputs": [
        {
          "id": 2074988507728,
          "index": 0,
          "multi_edges": true,
          "position": 5,
          "socket_type": 3
        }
      ],
      "content": {
        "formula_sections": [
          {
            "target_column": "cogs_usd",
            "formula_text": "[quantity] * [unit_cost]",
            "editor_height": 60,
            "target_dtype": ""
          },
          {
            "target_column": "gross_margin_usd",
            "formula_text": "[net_revenue_usd] * [cogs_usd]",
            "editor_height": 60,
            "target_dtype": ""
          },
          {
            "target_column": "margin_pct",
            "formula_text": "CASE\n    WHEN [net_revenue_usd] IS NULL OR [net_revenue_usd] = 0 THEN NULL\n    ELSE [gross_margin_usd] / [net_revenue_usd]\nEND",
            "editor_height": 118,
            "target_dtype": ""
          }
        ]
      },
      "label_text": "",
      "label_visible": false,
      "label_offset": 10.0,
      "node_code": 3,
      "node_type": "preparation",
      "op": "preparation.formula"
    },
    {
      "id": 2074988703216,
      "title": "Formula",
      "pos_x": 2353.7499999999995,
      "pos_y": 168.74999999999991,
      "inputs": [
        {
          "id": 2074988508528,
          "index": 0,
          "multi_edges": false,
          "position": 2,
          "socket_type": 1
        }
      ],
      "outputs": [
        {
          "id": 2074988531376,
          "index": 0,
          "multi_edges": true,
          "position": 5,
          "socket_type": 3
        }
      ],
      "content": {
        "formula_sections": [
          {
            "target_column": "order_year",
            "formula_text": "YEAR([order_ts])",
            "editor_height": 60,
            "target_dtype": ""
          },
          {
            "target_column": "order_month",
            "formula_text": "MONTH([order_ts])",
            "editor_height": 60,
            "target_dtype": ""
          },
          {
            "target_column": "order_year_month",
            "formula_text": "STRFTIME([order_ts], '%Y-%m')",
            "editor_height": 60,
            "target_dtype": ""
          },
          {
            "target_column": "is_bulk",
            "formula_text": "[quantity] >= 6",
            "editor_height": 60,
            "target_dtype": ""
          },
          {
            "target_column": "value_band",
            "formula_text": "CASE\n    WHEN [net_revenue_usd] IS NULL THEN NULL\n    WHEN [net_revenue_usd] <= 250  THEN 'Low'\n    WHEN [net_revenue_usd] <= 1000 THEN 'Medium'\n    ELSE 'High'\nEND\n",
            "editor_height": 120,
            "target_dtype": ""
          }
        ]
      },
      "label_text": "Orders",
      "label_visible": true,
      "label_offset": 10.0,
      "node_code": 3,
      "node_type": "preparation",
      "op": "preparation.formula"
    },
    {
      "id": 2073979223760,
      "title": "Formula",
      "pos_x": 2517.4999999999995,
      "pos_y": 173.74999999999994,
      "inputs": [
        {
          "id": 2073979213520,
          "index": 0,
          "multi_edges": false,
          "position": 2,
          "socket_type": 1
        }
      ],
      "outputs": [
        {
          "id": 2073979219280,
          "index": 0,
          "multi_edges": true,
          "position": 5,
          "socket_type": 3
        }
      ],
      "content": {
        "formula_sections": [
          {
            "target_column": "risk_score",
            "formula_text": "(CASE WHEN [is_returned] THEN 2 ELSE 0 END)\n+ (CASE WHEN [status] IN ('refunded', 'cancelled') THEN 2 ELSE 0 END)\n+ (CASE WHEN [net_revenue_usd] > 2000 THEN 1 ELSE 0 END)\n+ (CASE WHEN [margin_pct] < 0.10 THEN 1 ELSE 0 END)\n+ (CASE WHEN [segment] IS NULL THEN 2 ELSE 0 END)\n",
            "editor_height": 125,
            "target_dtype": ""
          },
          {
            "target_column": "risk_band",
            "formula_text": "CASE\n    WHEN [risk_score] >= 4 THEN 'High'\n    WHEN [risk_score] >= 2 THEN 'Medium'\n    ELSE 'Low'\nEND",
            "editor_height": 120,
            "target_dtype": ""
          }
        ]
      },
      "label_text": "Risk",
      "label_visible": true,
