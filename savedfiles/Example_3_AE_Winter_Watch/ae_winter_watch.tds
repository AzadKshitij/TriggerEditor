    {
      "id": 2714090806848,
      "title": "Formula",
      "pos_x": 520.0,
      "pos_y": 0.0,
      "inputs": [
        {
          "id": 2714090947584,
          "index": 0,
          "multi_edges": false,
          "position": 2,
          "socket_type": 1
        }
      ],
      "outputs": [
        {
          "id": 2714090948288,
          "index": 0,
          "multi_edges": true,
          "position": 5,
          "socket_type": 3
        }
      ],
      "content": {
        "settings": {
          "sections": [
            {
              "target_column": "Month",
              "formula_text": "strptime(regexp_extract([Period], '([A-Z]+)-([0-9]{4})$', 0), '%B-%Y')",
              "target_dtype": "Date",
              "editor_height": 120
            },
            {
              "target_column": "Attendances",
              "formula_text": "[AttT1] + [AttT2] + [AttOther] + [BookT1] + [BookT2] + [BookOther]",
              "target_dtype": "Integer",
              "editor_height": 120
            },
            {
              "target_column": "Over4",
              "formula_text": "[OverT1] + [OverT2] + [OverOther] + [OverBookT1] + [OverBookT2] + [OverBookOther]",
              "target_dtype": "Integer",
              "editor_height": 120
            },
            {
              "target_column": "Type1Att",
              "formula_text": "[AttT1] + [BookT1]",
              "target_dtype": "Integer",
              "editor_height": 120
            },
            {
              "target_column": "Type1Over4",
              "formula_text": "[OverT1] + [OverBookT1]",
              "target_dtype": "Integer",
              "editor_height": 120
            }
          ]
        }
      },
      "label_text": "Totals",
      "label_visible": true,
      "label_offset": 10.0,
      "node_code": 3,
      "node_type": "preparation",
      "op": "preparation.formula"
    },
    {
      "id": 2714090953856,
      "title": "Formula",
      "pos_x": 820.0,
      "pos_y": 0.0,
      "inputs": [
        {
          "id": 2714090960768,
          "index": 0,
          "multi_edges": false,
          "position": 2,
          "socket_type": 1
        }
      ],
      "outputs": [
        {
          "id": 2714090961536,
          "index": 0,
          "multi_edges": true,
          "position": 5,
          "socket_type": 3
        }
      ],
      "content": {
        "settings": {
          "sections": [
            {
              "target_column": "Within4Pct",
              "formula_text": "round(([Attendances] - [Over4]) * 100.0 / [Attendances], 2)",
              "target_dtype": "Float",
              "editor_height": 120
            },
            {
              "target_column": "Type1Within4Pct",
              "formula_text": "CASE WHEN [Type1Att] > 0 THEN round(([Type1Att] - [Type1Over4]) * 100.0 / [Type1Att], 2) ELSE NULL END",
              "target_dtype": "Float",
              "editor_height": 120
            },
            {
              "target_column": "Wait12Per1k",
              "formula_text": "round([Wait12h] * 1000.0 / [Attendances], 2)",
              "target_dtype": "Float",
              "editor_height": 120
            },
            {
              "target_column": "GapTo95",
              "formula_text": "round([Within4Pct] - 95, 2)",
              "target_dtype": "Float",
              "editor_height": 120
            },
            {
              "target_column": "Severity",
              "formula_text": "CASE WHEN [Type1Within4Pct] < 60 THEN 'Critical' WHEN [Type1Within4Pct] < 70 THEN 'Watch' ELSE 'OK' END",
              "target_dtype": "String",
              "editor_height": 120
            }
          ]
        }
      },
      "label_text": "Rates + severity",
      "label_visible": true,
      "label_offset": 10.0,
      "node_code": 3,
      "node_type": "preparation",
      "op": "preparation.formula"
    },
