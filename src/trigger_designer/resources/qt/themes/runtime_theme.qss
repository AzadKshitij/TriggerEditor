  /* padding-right = 36; 4 + 16*2 See scrollbar size */
  /* changed to 4px to fix #239 */
  /* Fixes #103, #111 */
  min-height: 1.5em;
  /* padding-top: 2px;     removed to fix #132 */
  /* padding-bottom: 2px;  removed to fix #132 */
  /* min-width: 75px;      removed to fix #109 */
  /* Needed to remove indicator - fix #132 */ }
  ComboBoxDelegate QAbstractItemView {
    border: 1px solid #242a30;
    border-radius: 0;
    background-color: #14171b;
    selection-background-color: #5680c2; }
    ComboBoxDelegate QAbstractItemView:hover {
      background-color: #14171b;
      color: #f5f7f9; }
    ComboBoxDelegate QAbstractItemView:selected {
      background: #5680c2;
      color: #242a30; }
    ComboBoxDelegate QAbstractItemView:alternate {
