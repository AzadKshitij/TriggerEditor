  ComboBoxDelegate:disabled {
    background-color: #14171b;
    color: #5c6672; }
  ComboBoxDelegate:hover {
    border: 1px solid #5680c2; }
  ComboBoxDelegate:focus {
    border: 1px solid #6a96d7; }
  ComboBoxDelegate:on {
    selection-background-color: #5680c2; }
  ComboBoxDelegate::indicator {
    border: none;
    border-radius: 0;
    background-color: transparent;
    selection-background-color: transparent;
    color: transparent;
    selection-color: transparent;
    /* Needed to remove indicator - fix #132 */ }
    ComboBoxDelegate::indicator:alternate {
      background: #14171b; }
  ComboBoxDelegate::item {
    /* Remove to fix #282, #285 and MR #288*/
    /*&:checked {
            font-weight: bold;
        }

        &:selected {
            border: 0px solid transparent;
        }
        */ }
    ComboBoxDelegate::item:alternate {
      background: #14171b; }
  ComboBoxDelegate::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 12px;
    border-left: 1px solid #242a30; }
  ComboBoxDelegate::down-arrow {
    image: url(":/qss_icons/dark/rc/arrow_down_disabled.png");
    height: 8px;
    width: 8px; }
    ComboBoxDelegate::down-arrow:on, ComboBoxDelegate::down-arrow:hover, ComboBoxDelegate::down-arrow:focus {
      image: url(":/qss_icons/dark/rc/arrow_down.png"); }

/* QSlider ----------------------------------------------------------------

https://doc.qt.io/qt-5/stylesheet-examples.html#customizing-qslider

--------------------------------------------------------------------------- */
QSlider:disabled {
  background: #14171b; }

QSlider:focus {
  border: none; }

QSlider::groove:horizontal {
  background: #242a30;
  border: 1px solid #242a30;
  height: 4px;
  margin: 0px;
  border-radius: 4px; }

QSlider::groove:vertical {
  background: #242a30;
  border: 1px solid #242a30;
  width: 4px;
  margin: 0px;
  border-radius: 4px; }

QSlider::add-page:vertical {
  background: #5680c2;
  border: 1px solid #242a30;
  width: 4px;
  margin: 0px;
  border-radius: 4px; }
  QSlider::add-page:vertical :disabled {
    background: #3a76ba; }

QSlider::sub-page:horizontal {
  background: #5680c2;
  border: 1px solid #242a30;
  height: 4px;
  margin: 0px;
  border-radius: 4px; }
  QSlider::sub-page:horizontal:disabled {
    background: #3a76ba; }

QSlider::handle:horizontal {
  background: #666666;
  border: 1px solid #242a30;
  width: 8px;
  height: 8px;
  margin: -8px 0px;
  border-radius: 4px; }
  QSlider::handle:horizontal:hover {
    background: #5680c2;
    border: 1px solid #5680c2; }
  QSlider::handle:horizontal:focus {
    border: 1px solid #6a96d7; }

QSlider::handle:vertical {
  background: #666666;
  border: 1px solid #242a30;
  width: 8px;
  height: 8px;
  margin: 0 -8px;
  border-radius: 4px; }
  QSlider::handle:vertical:hover {
    background: #5680c2;
    border: 1px solid #5680c2; }
  QSlider::handle:vertical:focus {
    border: 1px solid #6a96d7; }

/* QLineEdit --------------------------------------------------------------

https://doc.qt.io/qt-5/stylesheet-examples.html#customizing-qlineedit

--------------------------------------------------------------------------- */
QLineEdit {
  background-color: #14171b;
  padding-top: 2px;
  /* This QLineEdit fix  103, 111 */
  padding-bottom: 2px;
  /* This QLineEdit fix  103, 111 */
  padding-left: 4px;
  padding-right: 4px;
  border-style: solid;
  border: 1px solid #242a30;
  border-radius: 4px;
  color: #f5f7f9; }
  QLineEdit:disabled {
    background-color: #14171b;
    color: #5c6672; }
  QLineEdit:hover {
    border: 1px solid #5680c2;
    color: #f5f7f9; }
  QLineEdit:focus {
    border: 1px solid #6a96d7; }
  QLineEdit:selected {
    background-color: #5680c2;
    color: #242a30; }

/* QTabWiget --------------------------------------------------------------

https://doc.qt.io/qt-5/stylesheet-examples.html#customizing-qtabwidget-and-qtabbar

--------------------------------------------------------------------------- */
QTabWidget {
  padding: 2px;
  selection-background-color: #242a30; }
  QTabWidget QWidget {
    /* Fixes #189 */
    border-radius: 4px; }
  QTabWidget::pane {
    border-radius: 4px;
    margin: 0px;
    /* Fixes double border inside pane with pyqt5 */
    padding: -10px; }
    QTabWidget::pane:selected {
      background-color: #242a30; }

/* QTabBar ----------------------------------------------------------------

https://doc.qt.io/qt-5/stylesheet-examples.html#customizing-qtabwidget-and-qtabbar

--------------------------------------------------------------------------- */
QTabBar, QDockWidget QTabBar {
  qproperty-drawBase: 0;
  border-radius: 4px;
  margin: 0px;
  padding: 2px;
  border: 0;
  /* left: 5px; move to the right by 5px - removed for fix */ }
  QTabBar::close-button, QDockWidget QTabBar::close-button {
    border: 0;
    margin: 0;
    padding: 4px;
    image: url(":/qss_icons/dark/rc/window_close.png"); }
    QTabBar::close-button:hover, QDockWidget QTabBar::close-button:hover {
      image: url(":/qss_icons/dark/rc/window_close_focus.png"); }
    QTabBar::close-button:pressed, QDockWidget QTabBar::close-button:pressed {
      image: url(":/qss_icons/dark/rc/window_close_pressed.png"); }
  QTabBar::tab, QDockWidget QTabBar::tab {
    /* !selected and disabled ----------------------------------------- */
    /* selected ------------------------------------------------------- */ }
    QTabBar::tab:top:selected:disabled, QDockWidget QTabBar::tab:top:selected:disabled {
      color: #5c6672;
      background-color: #14171b; }
    QTabBar::tab:bottom:selected:disabled, QDockWidget QTabBar::tab:bottom:selected:disabled {
      color: #5c6672;
      background-color: #14171b; }
    QTabBar::tab:left:selected:disabled, QDockWidget QTabBar::tab:left:selected:disabled {
      color: #5c6672;
      background-color: #14171b; }
    QTabBar::tab:right:selected:disabled, QDockWidget QTabBar::tab:right:selected:disabled {
      color: #5c6672;
      background-color: #14171b; }
    QTabBar::tab:top:!selected:disabled, QDockWidget QTabBar::tab:top:!selected:disabled {
      color: #5c6672;
      background-color: #14171b; }
    QTabBar::tab:bottom:!selected:disabled, QDockWidget QTabBar::tab:bottom:!selected:disabled {
      color: #5c6672;
      background-color: #14171b; }
    QTabBar::tab:left:!selected:disabled, QDockWidget QTabBar::tab:left:!selected:disabled {
      color: #5c6672;
      background-color: #14171b; }
    QTabBar::tab:right:!selected:disabled, QDockWidget QTabBar::tab:right:!selected:disabled {
      color: #5c6672;
      background-color: #14171b; }
    QTabBar::tab:top:!selected, QDockWidget QTabBar::tab:top:!selected {
      margin-top: 2px; }
    QTabBar::tab:bottom:!selected, QDockWidget QTabBar::tab:bottom:!selected {
      margin-bottom: 2px; }
    QTabBar::tab:left:!selected, QDockWidget QTabBar::tab:left:!selected {
      margin-right: 2px; }
    QTabBar::tab:right:!selected, QDockWidget QTabBar::tab:right:!selected {
      margin-left: 2px; }
    QTabBar::tab:top, QDockWidget QTabBar::tab:top {
      background-color: #14171b;
      margin-left: 2px;
      padding-left: 4px;
      padding-right: 4px;
      padding-top: 2px;
      padding-bottom: 2px;
      min-width: 5px;
      border-top-left-radius: 4px;
      border-top-right-radius: 4px; }
      QTabBar::tab:top:selected, QDockWidget QTabBar::tab:top:selected {
        background-color: #22282e;
        border-top-left-radius: 4px;
        border-top-right-radius: 4px; }
      QTabBar::tab:top:!selected:hover, QDockWidget QTabBar::tab:top:!selected:hover {
        background-color: #1e242a;
        /* Fixes spyder-ide/spyder#9766 and #243 */
        padding-left: 3px;
        padding-right: 3px; }
    QTabBar::tab:bottom, QDockWidget QTabBar::tab:bottom {
      background-color: #242a30;
      margin-left: 2px;
      padding-left: 4px;
      padding-right: 4px;
      padding-top: 2px;
      padding-bottom: 2px;
      border-bottom-left-radius: 4px;
      border-bottom-right-radius: 4px;
      min-width: 5px; }
      QTabBar::tab:bottom:selected, QDockWidget QTabBar::tab:bottom:selected {
        background-color: #22282e;
        border-bottom-left-radius: 4px;
        border-bottom-right-radius: 4px; }
      QTabBar::tab:bottom:!selected:hover, QDockWidget QTabBar::tab:bottom:!selected:hover {
        background-color: #1e242a;
        /* Fixes spyder-ide/spyder#9766 and #243 */
        padding-left: 3px;
        padding-right: 3px; }
    QTabBar::tab:left, QDockWidget QTabBar::tab:left {
      background-color: #14171b;
      margin-top: 2px;
      padding-left: 2px;
      padding-right: 2px;
      padding-top: 4px;
      padding-bottom: 4px;
      border-top-left-radius: 4px;
      border-bottom-left-radius: 4px;
      min-height: 5px; }
      QTabBar::tab:left:selected, QDockWidget QTabBar::tab:left:selected {
        background-color: #22282e; }
      QTabBar::tab:left:!selected:hover, QDockWidget QTabBar::tab:left:!selected:hover {
        background-color: #1e242a;
        /* Fixes different behavior #271 */
        margin-right: 0px;
        padding-right: -1px; }
    QTabBar::tab:right, QDockWidget QTabBar::tab:right {
      background-color: #14171b;
      margin-top: 2px;
      padding-left: 2px;
      padding-right: 2px;
      padding-top: 4px;
      padding-bottom: 4px;
      border-top-right-radius: 4px;
      border-bottom-right-radius: 4px;
      min-height: 5px; }
      QTabBar::tab:right:selected, QDockWidget QTabBar::tab:right:selected {
        background-color: #22282e; }
      QTabBar::tab:right:!selected:hover, QDockWidget QTabBar::tab:right:!selected:hover {
        background-color: #1e242a;
        /* Fixes different behavior #271 */
        margin-left: 0px;
        padding-left: 0px; }
  QTabBar QToolButton, QDockWidget QTabBar QToolButton {
    /* Fixes #136 */
    background-color: #242a30;
    height: 12px;
    width: 12px; }
    QTabBar QToolButton:pressed, QDockWidget QTabBar QToolButton:pressed {
      background-color: #242a30; }
      QTabBar QToolButton:pressed:hover, QDockWidget QTabBar QToolButton:pressed:hover {
        border: 1px solid #5680c2; }
    QTabBar QToolButton::left-arrow:enabled, QDockWidget QTabBar QToolButton::left-arrow:enabled {
      image: url(":/qss_icons/dark/rc/arrow_left.png"); }
    QTabBar QToolButton::left-arrow:disabled, QDockWidget QTabBar QToolButton::left-arrow:disabled {
      image: url(":/qss_icons/dark/rc/arrow_left_disabled.png"); }
    QTabBar QToolButton::right-arrow:enabled, QDockWidget QTabBar QToolButton::right-arrow:enabled {
      image: url(":/qss_icons/dark/rc/arrow_right.png"); }
    QTabBar QToolButton::right-arrow:disabled, QDockWidget QTabBar QToolButton::right-arrow:disabled {
      image: url(":/qss_icons/dark/rc/arrow_right_disabled.png"); }

/* QDockWiget -------------------------------------------------------------

--------------------------------------------------------------------------- */
QDockWidget {
  outline: 1px solid #242a30;
  background-color: #14171b;
  border: 1px solid #242a30;
  border-radius: 4px;
  titlebar-close-icon: url(":/qss_icons/dark/rc/transparent.png");
  titlebar-normal-icon: url(":/qss_icons/dark/rc/transparent.png"); }
  QDockWidget::title {
    /* Better size for title bar */
    padding: 3px;
    spacing: 4px;
    border: none;
    background-color: #242a30; }
  QDockWidget::close-button {
    icon-size: 12px;
    border: none;
    background: transparent;
    background-image: transparent;
    border: 0;
    margin: 0;
    padding: 0;
    image: url(":/qss_icons/dark/rc/window_close.png"); }
    QDockWidget::close-button:hover {
      image: url(":/qss_icons/dark/rc/window_close_focus.png"); }
    QDockWidget::close-button:pressed {
      image: url(":/qss_icons/dark/rc/window_close_pressed.png"); }
  QDockWidget::float-button {
    icon-size: 12px;
    border: none;
    background: transparent;
    background-image: transparent;
    border: 0;
    margin: 0;
    padding: 0;
    image: url(":/qss_icons/dark/rc/window_undock.png"); }
    QDockWidget::float-button:hover {
      image: url(":/qss_icons/dark/rc/window_undock_focus.png"); }
    QDockWidget::float-button:pressed {
      image: url(":/qss_icons/dark/rc/window_undock_pressed.png"); }

/* QTreeView QListView QTableView -----------------------------------------

https://doc.qt.io/qt-5/stylesheet-examples.html#customizing-qtreeview
https://doc.qt.io/qt-5/stylesheet-examples.html#customizing-qlistview
https://doc.qt.io/qt-5/stylesheet-examples.html#customizing-qtableview

--------------------------------------------------------------------------- */
QTreeView:branch:selected, QTreeView:branch:hover {
  background: url(":/qss_icons/dark/rc/transparent.png"); }

QTreeView:branch:has-siblings:!adjoins-item {
  border-image: url(":/qss_icons/dark/rc/branch_line.png") 0; }

QTreeView:branch:has-siblings:adjoins-item {
  border-image: url(":/qss_icons/dark/rc/branch_more.png") 0; }

QTreeView:branch:!has-children:!has-siblings:adjoins-item {
  border-image: url(":/qss_icons/dark/rc/branch_end.png") 0; }

QTreeView:branch:has-children:!has-siblings:closed, QTreeView:branch:closed:has-children:has-siblings {
  border-image: none;
  image: url(":/qss_icons/dark/rc/branch_closed.png"); }

QTreeView:branch:open:has-children:!has-siblings, QTreeView:branch:open:has-children:has-siblings {
  border-image: none;
  image: url(":/qss_icons/dark/rc/branch_open.png"); }

QTreeView:branch:has-children:!has-siblings:closed:hover, QTreeView:branch:closed:has-children:has-siblings:hover {
  image: url(":/qss_icons/dark/rc/branch_closed_focus.png"); }

QTreeView:branch:open:has-children:!has-siblings:hover, QTreeView:branch:open:has-children:has-siblings:hover {
  image: url(":/qss_icons/dark/rc/branch_open_focus.png"); }

QTreeView::indicator:checked,
QListView::indicator:checked,
QTableView::indicator:checked,
QColumnView::indicator:checked {
  image: url(":/qss_icons/dark/rc/checkbox_checked.png"); }
  QTreeView::indicator:checked:hover, QTreeView::indicator:checked:focus, QTreeView::indicator:checked:pressed,
  QListView::indicator:checked:hover,
  QListView::indicator:checked:focus,
  QListView::indicator:checked:pressed,
  QTableView::indicator:checked:hover,
  QTableView::indicator:checked:focus,
  QTableView::indicator:checked:pressed,
  QColumnView::indicator:checked:hover,
  QColumnView::indicator:checked:focus,
  QColumnView::indicator:checked:pressed {
    image: url(":/qss_icons/dark/rc/checkbox_checked_focus.png"); }

QTreeView::indicator:unchecked,
QListView::indicator:unchecked,
QTableView::indicator:unchecked,
QColumnView::indicator:unchecked {
  image: url(":/qss_icons/dark/rc/checkbox_unchecked.png"); }
  QTreeView::indicator:unchecked:hover, QTreeView::indicator:unchecked:focus, QTreeView::indicator:unchecked:pressed,
  QListView::indicator:unchecked:hover,
  QListView::indicator:unchecked:focus,
  QListView::indicator:unchecked:pressed,
  QTableView::indicator:unchecked:hover,
  QTableView::indicator:unchecked:focus,
  QTableView::indicator:unchecked:pressed,
  QColumnView::indicator:unchecked:hover,
  QColumnView::indicator:unchecked:focus,
  QColumnView::indicator:unchecked:pressed {
    image: url(":/qss_icons/dark/rc/checkbox_unchecked_focus.png"); }

QTreeView::indicator:indeterminate,
QListView::indicator:indeterminate,
QTableView::indicator:indeterminate,
QColumnView::indicator:indeterminate {
  image: url(":/qss_icons/dark/rc/checkbox_indeterminate.png"); }
  QTreeView::indicator:indeterminate:hover, QTreeView::indicator:indeterminate:focus, QTreeView::indicator:indeterminate:pressed,
  QListView::indicator:indeterminate:hover,
  QListView::indicator:indeterminate:focus,
  QListView::indicator:indeterminate:pressed,
  QTableView::indicator:indeterminate:hover,
  QTableView::indicator:indeterminate:focus,
  QTableView::indicator:indeterminate:pressed,
  QColumnView::indicator:indeterminate:hover,
  QColumnView::indicator:indeterminate:focus,
  QColumnView::indicator:indeterminate:pressed {
    image: url(":/qss_icons/dark/rc/checkbox_indeterminate_focus.png"); }

QTreeView,
QListView,
QTableView,
QColumnView {
  background-color: #14171b;
  border: 1px solid #242a30;
  color: #f5f7f9;
  gridline-color: #242a30;
  border-radius: 4px; }
  QTreeView:disabled,
  QListView:disabled,
  QTableView:disabled,
  QColumnView:disabled {
    background-color: #14171b;
    color: #5c6672; }
  QTreeView:selected,
  QListView:selected,
  QTableView:selected,
  QColumnView:selected {
    background-color: #5680c2;
    color: #242a30; }
  QTreeView:focus,
  QListView:focus,
  QTableView:focus,
  QColumnView:focus {
    border: 1px solid #6a96d7; }
  QTreeView::item:pressed,
  QListView::item:pressed,
  QTableView::item:pressed,
  QColumnView::item:pressed {
    background-color: #5680c2; }
  QTreeView::item:selected:active,
  QListView::item:selected:active,
  QTableView::item:selected:active,
  QColumnView::item:selected:active {
    background-color: #5680c2; }
  QTreeView::item:selected:!active,
  QListView::item:selected:!active,
  QTableView::item:selected:!active,
  QColumnView::item:selected:!active {
    color: #f5f7f9;
    background-color: #1e242a; }
  QTreeView::item:!selected:hover,
  QListView::item:!selected:hover,
  QTableView::item:!selected:hover,
  QColumnView::item:!selected:hover {
    outline: 0;
    color: #f5f7f9;
    background-color: #1e242a; }

QTableCornerButton::section {
  background-color: #14171b;
  border: 1px transparent #242a30;
  border-radius: 0px; }

/* QHeaderView ------------------------------------------------------------

https://doc.qt.io/qt-5/stylesheet-examples.html#customizing-qheaderview

--------------------------------------------------------------------------- */
QHeaderView {
  background-color: #242a30;
  border: 0px transparent #242a30;
  padding: 0;
  margin: 0;
  border-radius: 0; }
  QHeaderView:disabled {
    background-color: #242a30;
    border: 1px transparent #242a30; }
  QHeaderView::section {
    background-color: #242a30;
    color: #f5f7f9;
    border-radius: 0;
    text-align: left;
    font-size: 13px; }
    QHeaderView::section::horizontal {
      padding-top: 0;
      padding-bottom: 0;
      padding-left: 4px;
      padding-right: 4px;
      border-left: 1px solid #14171b; }
      QHeaderView::section::horizontal::first, QHeaderView::section::horizontal::only-one {
        border-left: 1px solid #242a30; }
      QHeaderView::section::horizontal:disabled {
        color: #5c6672; }
    QHeaderView::section::vertical {
      padding-top: 0;
      padding-bottom: 0;
      padding-left: 4px;
      padding-right: 4px;
      border-top: 1px solid #14171b; }
      QHeaderView::section::vertical::first, QHeaderView::section::vertical::only-one {
        border-top: 1px solid #242a30; }
      QHeaderView::section::vertical:disabled {
        color: #5c6672; }
  QHeaderView::down-arrow {
    /* Those settings (border/width/height/background-color) solve bug */
    /* transparent arrow background and size */
    background-color: #242a30;
    border: none;
    height: 12px;
    width: 12px;
    padding-left: 2px;
    padding-right: 2px;
    image: url(":/qss_icons/dark/rc/arrow_down.png"); }
  QHeaderView::up-arrow {
    background-color: #242a30;
    border: none;
    height: 12px;
    width: 12px;
    padding-left: 2px;
    padding-right: 2px;
    image: url(":/qss_icons/dark/rc/arrow_up.png"); }

/* QToolBox --------------------------------------------------------------

https://doc.qt.io/qt-5/stylesheet-examples.html#customizing-qtoolbox

--------------------------------------------------------------------------- */
QToolBox {
  padding: 0px;
  border: 0px;
  border: 1px solid #242a30; }
  QToolBox:selected {
    padding: 0px;
    border: 2px solid #5680c2; }
  QToolBox::tab {
    background-color: #14171b;
    border: 1px solid #242a30;
    color: #f5f7f9;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px; }
    QToolBox::tab:disabled {
      color: #5c6672; }
    QToolBox::tab:selected {
      background-color: #2f363d;
      border-bottom: 2px solid #5680c2; }
      QToolBox::tab:selected:disabled {
        background-color: #242a30;
        border-bottom: 2px solid #3a76ba; }
    QToolBox::tab:!selected {
      background-color: #242a30;
      border-bottom: 2px solid #242a30; }
      QToolBox::tab:!selected:disabled {
        background-color: #14171b; }
    QToolBox::tab:hover {
      border-color: #6a96d7;
      border-bottom: 2px solid #6a96d7; }
  QToolBox QScrollArea {
    padding: 0px;
    border: 0px;
    background-color: #14171b; }

/* QFrame -----------------------------------------------------------------

https://doc.qt.io/qt-5/stylesheet-examples.html#customizing-qframe
https://doc.qt.io/qt-5/qframe.html#-prop
https://doc.qt.io/qt-5/qframe.html#details
https://stackoverflow.com/questions/14581498/qt-stylesheet-for-hline-vline-color

--------------------------------------------------------------------------- */
/* (dot) .QFrame  fix #141, #126, #123 */
.QFrame {
  border-radius: 4px;
  border: 1px solid #242a30;
  /* No frame */
  /* HLine */
  /* HLine */ }
  .QFrame[frameShape="0"] {
    border-radius: 4px;
    border: 1px transparent #242a30; }
  .QFrame[frameShape="4"] {
    max-height: 2px;
    border: none;
    background-color: #242a30; }
  .QFrame[frameShape="5"] {
    max-width: 2px;
    border: none;
    background-color: #242a30; }

/* QSplitter --------------------------------------------------------------

https://doc.qt.io/qt-5/stylesheet-examples.html#customizing-qsplitter

--------------------------------------------------------------------------- */
QSplitter {
  background-color: #242a30;
  spacing: 0px;
  padding: 0px;
  margin: 0px; }
  QSplitter::handle {
    background-color: #242a30;
    border: 0px solid #14171b;
    spacing: 0px;
    padding: 1px;
    margin: 0px; }
    QSplitter::handle:hover {
      background-color: #666666; }
    QSplitter::handle:horizontal {
      width: 5px;
      image: url(":/qss_icons/dark/rc/line_vertical.png"); }
    QSplitter::handle:vertical {
      height: 5px;
      image: url(":/qss_icons/dark/rc/line_horizontal.png"); }

/* QDateEdit, QDateTimeEdit -----------------------------------------------

--------------------------------------------------------------------------- */
QDateEdit, QDateTimeEdit {
  selection-background-color: #5680c2;
  border-style: solid;
  border: 1px solid #242a30;
  border-radius: 4px;
  /* This fixes 103, 111 */
  padding-top: 2px;
  /* This fixes 103, 111 */
  padding-bottom: 2px;
  padding-left: 4px;
  padding-right: 4px;
  min-width: 10px; }
  QDateEdit:on, QDateTimeEdit:on {
    selection-background-color: #5680c2; }
  QDateEdit::drop-down, QDateTimeEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 12px;
    border-left: 1px solid #242a30; }
  QDateEdit::down-arrow, QDateTimeEdit::down-arrow {
    image: url(":/qss_icons/dark/rc/arrow_down_disabled.png");
    height: 8px;
    width: 8px; }
    QDateEdit::down-arrow:on, QDateEdit::down-arrow:hover, QDateEdit::down-arrow:focus, QDateTimeEdit::down-arrow:on, QDateTimeEdit::down-arrow:hover, QDateTimeEdit::down-arrow:focus {
      image: url(":/qss_icons/dark/rc/arrow_down.png"); }
  QDateEdit QAbstractItemView, QDateTimeEdit QAbstractItemView {
    background-color: #14171b;
    border-radius: 4px;
    border: 1px solid #242a30;
    selection-background-color: #5680c2; }

/* QAbstractView ----------------------------------------------------------

--------------------------------------------------------------------------- */
QAbstractView:hover {
  border: 1px solid #5680c2;
  color: #f5f7f9; }

QAbstractView:selected {
  background: #5680c2;
  color: #242a30; }

/* PlotWidget -------------------------------------------------------------

--------------------------------------------------------------------------- */
PlotWidget {
  /* Fix cut labels in plots #134 */
  padding: 0px; }



/* Custom Style -------------------------------------------------------------

--------------------------------------------------------------------------- */
QDMNodeIconContentWidget {
  background: transparent;
  border: 1px transparent
}
QDMNodeIconContentWidget QFrame {
  background: transparent;
  border: 1px transparent;
}
UniqueContentList::item{
    padding: 4px;
    margin: 1px 0px;
}
/* TriggerDesigner shared config widgets ---------------------------------- */
QLabel#ConfigSectionInfo {
  color: #919ba6;
  font-size: 10px;
  margin: 2px; }
QLabel#EmptyStateLabel {
  color: #919ba6; }
/* Data type editor inside the Select table: match the dock theme instead of
   the bare Fusion combo colours. */
QComboBox#DataTypeCombo {
  background-color: #101418;
  color: #f5f7f9;
  border: 1px solid #5680c2;
  border-radius: 4px;
  /* The editor is opened inside a 22px table row; a taller minimum would
     make it overlap the row below. */
  min-height: 0px;
  padding: 0px 4px; }
  QComboBox#DataTypeCombo:focus {
    border: 1px solid #6a96d7; }
/* Data Preview dock and panel ------------------------------------------- */
/* One strip of chrome over the table: node chip, socket chip, live search,
   scope, provenance, counts, then pin/refresh/options. Chips sit a shade
   below the strip; the search field is the app's standard field on that
   shade. */
QFrame#PreviewStrip {
  background-color: #191e22;
  border: 0px;
  border-bottom: 1px solid #242a30; }
QFrame#PreviewNodeChip, QFrame#PreviewSocketChip, QFrame#PreviewCountsChip {
  background-color: #14171b;
  border: 1px solid #242a30;
  border-radius: 4px; }
QLabel#PreviewNodeLabel {
  color: #c6cdd5;
  font-size: 11px; }
QLabel#PreviewPinDot {
  background-color: #5680c2;
  border-radius: 3px; }
QLabel#PreviewStatusLabel {
  color: #919ba6;
  font-size: 11px; }
QLabel#PreviewLimitedBadge {
  background-color: #4a3407;
  color: #f5f7f9;
  border-radius: 3px;
  font-size: 10px;
  padding: 1px 5px; }
QLabel#PreviewSourceBadge {
  color: #919ba6;
  border: 1px solid #242a30;
  border-radius: 3px;
  font-size: 10px;
  padding: 1px 5px; }
  QLabel#PreviewSourceBadge[source="run"] {
    color: #48a878;
    border: 1px solid #48a878; }
QLineEdit#PreviewSearchEdit {
  background-color: #101418;
  border: 1px solid #242a30;
  border-radius: 4px;
  color: #f5f7f9; }
  QLineEdit#PreviewSearchEdit:hover {
    border: 1px solid #5680c2; }
  QLineEdit#PreviewSearchEdit:focus {
    border: 1px solid #6a96d7; }
  QLineEdit#PreviewSearchEdit:disabled {
    color: #5c6672; }
QComboBox#PreviewScopeCombo {
  background-color: #14171b;
  color: #c6cdd5;
  border: 1px solid #242a30;
  border-radius: 4px;
  padding: 0px 4px; }
  QComboBox#PreviewScopeCombo:hover {
    border: 1px solid #5680c2; }
  QComboBox#PreviewScopeCombo:focus {
    border: 1px solid #6a96d7; }
  QComboBox#PreviewScopeCombo:disabled {
    color: #5c6672; }
QComboBox#PreviewSocketCombo {
  background-color: transparent;
  color: #c6cdd5;
  border: 0px;
  padding: 0px 4px; }
  QComboBox#PreviewSocketCombo:hover {
    color: #f5f7f9; }
  QComboBox#PreviewSocketCombo:disabled {
    color: #5c6672; }
  QComboBox#PreviewSocketCombo::drop-down {
    border-left: 0px; }
/* The pin is a checkable icon button: an objectName selector outranks
   QPushButton:hover, so every state is restated here (§4.5) and the checked
   state comes last, with its own hover, so a pinned button still reacts. */
QPushButton#PreviewPinButton {
  background-color: #191e21;
  color: #f5f7f9;
  border: 1px solid #191e21;
  border-radius: 4px;
  padding: 0px; }
  QPushButton#PreviewPinButton:hover {
    background-color: #22282e;
    border: 1px solid #5680c2; }
  QPushButton#PreviewPinButton:pressed {
    background-color: #2c333a;
    border: 1px solid #5680c2; }
  QPushButton#PreviewPinButton:disabled {
    background-color: #191e21;
    border: 1px solid #191e21;
    color: #5c6672; }
  QPushButton#PreviewPinButton:checked {
    background-color: #5680c2;
    border: 1px solid #5680c2; }
  QPushButton#PreviewPinButton:checked:hover {
    background-color: #6a96d7;
    border: 1px solid #6a96d7; }
/* Join output column list: source badges, headers, dtype hints */
QLabel#JoinSourceLeft {
  background-color: #6a96d7;
  color: #ffffff;
  border-radius: 3px;
  font-weight: bold; }
QLabel#JoinSourceRight {
  background-color: #e0686c;
  color: #ffffff;
  border-radius: 3px;
  font-weight: bold; }
QLabel#JoinSourceHeaderLeft {
  color: #6a96d7;
  font-weight: bold;
  padding: 2px 5px; }
QLabel#JoinSourceHeaderRight {
  color: #e0686c;
  font-weight: bold;
  padding: 2px 5px; }
QLabel#JoinDtypeLabel {
  color: #919ba6; }
/* Formula cards: flat card; the header stays in view when folded */
QFrame#FormulaCard {
  background-color: #191e22;
  border: 1px solid #242a30;
  border-radius: 4px; }
QFrame#FormulaCardHeader {
  background-color: transparent;
  border: 0px;
  border-bottom: 1px solid #242a30; }
  QFrame#FormulaCardHeader:hover {
    background-color: #22282e; }
QFrame#FormulaCardBody {
  background-color: transparent;
  border: 0px; }
QFrame#formulaResizeGrip {
  background-color: #2f363d; }
QFrame#formulaSeparator {
  background-color: #2f363d;
  border: none; }
QLabel#formulaSectionError {
  color: #e0686c;
  font-size: 11px; }
QLabel#formulaSectionCount {
  color: #919ba6; }
QTextEdit#formulaEditor {
  background-color: #101418;
  color: #f5f7f9;
  border: 1px solid #2f363d;
  selection-background-color: #264f78;
  selection-color: #ffffff; }

/* Signal config dock -------------------------------------------------------
   Inspector header, context strip, flat sections and the shared form
   controls. Every objectName that paints its own fill restates hover,
   pressed and disabled here: an objectName selector outranks a generic
   pseudo-state, so the states are invisible without this (§4.5). */

QFrame#InspectorHeader {
  background-color: transparent;
  border: 0px;
  border-bottom: 1px solid #242a30; }
QFrame#InspectorRail {
  background-color: #919ba6;
  border: 0px;
  border-radius: 2px; }
  QFrame#InspectorRail[category="input"] { background-color: #c4574f; }
  QFrame#InspectorRail[category="prepare"] { background-color: #3f9e63; }
  QFrame#InspectorRail[category="join"] { background-color: #4f7fd1; }
  QFrame#InspectorRail[category="transform"] { background-color: #7c5cbf; }
  QFrame#InspectorRail[category="report"] { background-color: #c99a3c; }
QLabel#InspectorTitle {
  color: #f5f7f9;
  font-size: 13px;
  font-weight: 600; }

QFrame#ContextStrip {
  background-color: #191e22;
  border: 1px solid #242a30;
  border-radius: 4px; }
QLabel#Chip {
  background-color: #14171b;
  border: 1px solid #242a30;
  border-radius: 4px;
  color: #c6cdd5;
  font-size: 10px;
  padding: 2px 6px; }
  QLabel#Chip[tone="accent"] {
    color: #6a96d7;
    border: 1px solid #5680c2; }
  QLabel#Chip[tone="muted"] { color: #919ba6; }
QLabel#ContextLabel {
  color: #919ba6;
  font-size: 10px; }
QLabel#StatusBadge {
  background-color: transparent;
  border: 1px solid #2f363d;
  border-radius: 3px;
  color: #c6cdd5;
  font-size: 10px;
  font-weight: 600;
  padding: 1px 5px; }
  QLabel#StatusBadge[tone="success"] { color: #48a878; border: 1px solid #48a878; }
  QLabel#StatusBadge[tone="warning"] { color: #d9a441; border: 1px solid #d9a441; }
  QLabel#StatusBadge[tone="danger"] { color: #e0686c; border: 1px solid #e0686c; }
  QLabel#StatusBadge[tone="info"] { color: #5ba8d6; border: 1px solid #5ba8d6; }

/* Flat section: overline + hairline, no group-box frame. */
QFrame#ConfigSection, QFrame#SectionBody {
  background-color: transparent;
  border: 0px; }
QFrame#SectionDivider {
  background-color: #242a30;
  border: 0px; }
QFrame#SectionHeader {
  background-color: transparent;
  border: 0px;
  border-bottom: 1px solid #242a30; }
  QFrame#SectionHeader[collapsible="true"]:hover {
    background-color: #22282e; }
QLabel#SectionTitle {
  color: #919ba6;
  font-size: 10px;
  font-weight: 600; }
QLabel#SectionCount {
  color: #5c6672;
  font-size: 10px; }
QLabel#SectionChevron {
  color: #919ba6;
  font-size: 10px; }
QLabel#ConfigSectionInfo {
  color: #919ba6;
  font-size: 10px; }

/* Form rhythm: label left, control right (FormRow); label above (FormGrid). */
QLabel#FieldLabel {
  color: #919ba6;
  font-size: 11px; }
QLabel#FieldHint {
  color: #919ba6;
  font-size: 10px; }
QFrame#FieldRow, QFrame#FieldStack {
  background-color: transparent;
  border: 0px; }

/* Segmented mode switch: one exclusive row of 30px buttons. */
QWidget#Segmented {
  background-color: transparent;
  border: 0px; }
QPushButton#SegmentButton {
  background-color: #191e21;
  color: #c6cdd5;
  border: 1px solid #191e21;
  border-radius: 4px;
  padding: 0px 10px; }
  QPushButton#SegmentButton:hover {
    background-color: #22282e;
    border: 1px solid #5680c2;
    color: #f5f7f9; }
  QPushButton#SegmentButton:pressed {
    background-color: #2c333a;
    border: 1px solid #5680c2; }
  QPushButton#SegmentButton:disabled {
    background-color: #191e21;
    border: 1px solid #191e21;
    color: #5c6672; }
  QPushButton#SegmentButton:checked {
    background-color: #5680c2;
    border: 1px solid #5680c2;
    color: #ffffff; }
  QPushButton#SegmentButton:checked:hover {
    background-color: #6a96d7;
    border: 1px solid #6a96d7;
    color: #ffffff; }

/* Tables inside the dock follow the section rhythm. */
QTableView#ColumnTable {
  background-color: #14171b;
  border: 1px solid #242a30;
  border-radius: 4px; }
QTableView#ColumnTable::item {
  padding: 1px 4px; }
QTableView#ColumnTable QHeaderView::section {
  background-color: #191e22;
  color: #919ba6;
  border: 0px;
  border-bottom: 1px solid #242a30;
  font-size: 11px;
  padding: 2px 4px; }

/* Column checklist: one dense row per column, flush on the section body.
   ``padding: 0`` because QAbstractScrollArea's 2px padding (plus its 1px
   border) is counted as a frame, which leaves the viewport 4px shorter than
   the height the rows asked for - and every list then shows a scrollbar it
   does not need. */
QWidget#ColumnChecklist, QWidget#ColumnChecklist QScrollArea {
  background-color: transparent;
  border: 0px;
  padding: 0px; }
QWidget#ColumnChecklist QCheckBox {
  padding: 3px 2px;
  border-radius: 3px; }
  QWidget#ColumnChecklist QCheckBox:hover {
    background-color: #22282e; }

/* Join output list: same surface as the column tables. */
QListWidget#JoinOutputList {
  background-color: #14171b;
  border: 1px solid #242a30;
  border-radius: 4px; }
  QListWidget#JoinOutputList::item {
    padding: 3px 4px;
    border-radius: 3px; }
  QListWidget#JoinOutputList::item:hover {
    background-color: #22282e; }
  QListWidget#JoinOutputList::item:selected {
    background-color: #2c333a;
    color: #f5f7f9; }

/* Scrollable node panels sit flush on the dock surface. */
QWidget#ConfigDockWidget QScrollArea {
  background-color: transparent;
  border: 0px;
  padding: 0px; }
/* The pane's own scroll area (one scrollbar for the whole configuration).
   Its viewport and content must stay transparent or the scroll frame paints
   a second surface over the dock background. The list scroll areas inside a
   node get the same treatment. */
QWidget#ConfigDockWidget QScrollArea > QWidget#qt_scrollarea_viewport,
QWidget#ConfigDockContent {
  background-color: transparent; }
/* Combos that live inside a 22px table cell must not claim the dock's 30px
   control height; the cell sets their geometry. */
QComboBox#CellCombo {
  min-height: 0px;
  padding: 0px 2px; }
