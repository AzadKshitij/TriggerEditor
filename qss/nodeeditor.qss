QDMNodeContentWidget {
  background: transparent;
}
QDMNodeContentWidget QFrame {
  background: transparent;
}
QDMGraphicsNode QGraphicsTextItem{
  color: #000000;
  background: #000000;
  border: 1px solid #0f0;
  border-radius: 5px;
  padding: 5px;
}

QDMGraphicsNode QPainterPath#nodeTitle {
  background: #2c313a;
  color: #fff;
  border: 1px solid #0f0;
  border-radius: 5px;
  padding: 5px;
}

QDMNodeContentWidget QLineEdit {
  background: #2c313a;
  color: #fff;
}
QDMNodeContentWidget QLabel {
  color: #000000;
  background: #000000;
  border: 1px solid #0f0;
  border-radius: 5px;
  padding: 5px;
}
QDMNodeContentWidget QLabel#calc_node_bg,
QDMNodeContentWidget QLabel#calc_node_mul,
QDMNodeContentWidget QLabel#calc_node_div {
  background: transparent;
  height: 0px;
  color: #fe0000;
  font-size: 72px;
  max-height: 49px;
  min-height: 49px;
  padding-left: 94px;
}



QDMNodeContentWidget QLabel#calc_node_mul,
QDMNodeContentWidget QLabel#calc_node_div {
  padding-top: 12px;
}
QDMNodeContentWidget QLabel#calc_node_output {
  min-width: 150px;
  max-width: 150px;
  min-height: 45px;
  max-height: 45px;
  margin-left: 10px;
  margin-top: 5px;
  font-size: 28px;
}

QDMNodeContentWidget QLineEdit#calc_node_input {
  width: 140px;
  height: 36px;
  margin-top: 5px;
  margin-left: 5px;
  font-size: 28px;
  color: #000;
  background: #fff;
  border: 1px solid #0f0;
  border-radius: 5px;
}
QGraphicsView {
  selection-background-color: #fff;
}
